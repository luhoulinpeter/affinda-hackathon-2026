# Names only. Set real values in your host's dashboard, never in Git.
PORT=
# Deployed mode: the public https address of the site, e.g. https://your-app.example.com
PUBLIC_ORIGIN=
# Mo's account on the deployed server (non-empty username and password)
MO_USERNAME=
MO_PASSWORD=
# Optional: where store.json is kept (default .riverside/)
RIVERSIDE_DATA_DIR=

# Google Maps browser key. Prefer a no-billing Maps Demo Key for this MVP.
GOOGLE_MAPS_API_KEY=
# Separate server-only key with Routes API enabled; never use this as the browser key.
# Keep disabled until Google billing/quota approval. Calls share a persisted lifetime
# counter across restarts; raising the limit requires approval. Default: zero calls.
GOOGLE_ROUTES_API_KEY=
RIVERSIDE_GOOGLE_ROUTES_ENABLED=false
RIVERSIDE_GOOGLE_ROUTES_MAX_CALLS=0

# Copy to .env locally. Never commit real keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
TYPESAFE_API_KEY=
# Keep false until setup checks and explicit live-test approval. See SETUP.md.
RIVERSIDE_OPENROUTER_ENABLED=false
RIVERSIDE_JEV_ENABLED=false
